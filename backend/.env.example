# Copy to backend/.env and adjust. Never commit .env.
FINPILOT_ENV=development
FINPILOT_DATABASE_URL=postgresql+psycopg://localhost:5432/finpilot
# Used only by the pytest suite (the database is dropped/recreated per run)
FINPILOT_TEST_DATABASE_URL=postgresql+psycopg://localhost:5432/finpilot_test
# Comma-separated list of browser origins allowed to call the API
FINPILOT_CORS_ORIGINS=http://localhost:5190,http://127.0.0.1:5190
# Session lifetime in hours
FINPILOT_SESSION_TTL_HOURS=12
# Set true when serving over HTTPS so the session cookie gets the Secure flag
FINPILOT_COOKIE_SECURE=false
# Login / registration attempts allowed per client IP per minute
FINPILOT_AUTH_RATE_LIMIT_PER_MINUTE=10
FINPILOT_LOG_LEVEL=INFO
